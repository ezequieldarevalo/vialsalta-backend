# ==============================================
# CONFIGURACIÓN DEL SISTEMA DE OBLEAS
# ==============================================
# Este archivo contiene todas las variables de entorno necesarias
# Copia este archivo como .env y completa con tus valores

# ==============================================
# ENTORNO Y PUERTO
# ==============================================
NODE_ENV=development
PORT=3000

# ==============================================
# BASE DE DATOS - PostgreSQL
# ==============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=obleas_db

# Alias para compatibilidad
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=obleas_db

# ==============================================
# JWT - Autenticación
# ==============================================
# IMPORTANTE: Cambiar en producción por un string aleatorio largo
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# ==============================================
# QR Security - CRÍTICO para verificación de certificados
# ==============================================
# Genera un secreto único con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=your-super-secret-qr-signing-key-change-in-production-use-64-chars-minimum

# ==============================================
# CORS - Frontend
# ==============================================
CORS_ORIGIN=http://localhost:5173
# En producción: CORS_ORIGIN=https://tudominio.com

# ==============================================
# FRONTEND URL
# ==============================================
FRONTEND_URL=http://localhost:5173
# En producción: FRONTEND_URL=https://tudominio.com

# ==============================================
# MERCADOPAGO - Pagos (OPCIONAL)
# ==============================================
# Obtener desde: https://www.mercadopago.com.ar/developers/panel
MERCADOPAGO_ACCESS_TOKEN=APP-XXXXXXXXXXXXXXXX
MERCADOPAGO_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXX

# ==============================================
# EMAIL - Nodemailer (OPCIONAL)
# ==============================================
# Si no configuras estos valores, el sistema funcionará pero sin enviar emails

# Gmail (configuración más simple)
# 1. Crear "App Password" en tu cuenta de Gmail
# 2. Ir a: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu_app_password_de_16_caracteres

# Otros proveedores (SendGrid, Mailgun, etc)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=apikey
# EMAIL_PASSWORD=TU_API_KEY

# ==============================================
# ALMACENAMIENTO DE ARCHIVOS (OPCIONAL)
# ==============================================
# Por defecto usa almacenamiento local
# Para producción se recomienda S3/Spaces

# Local (por defecto)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# DigitalOcean Spaces (alternativa)
# STORAGE_TYPE=spaces
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_BUCKET=obleas-storage
# SPACES_ACCESS_KEY_ID=tu_access_key
# SPACES_SECRET_ACCESS_KEY=tu_secret_key
# SPACES_REGION=nyc3

# AWS S3 (alternativa)
# STORAGE_TYPE=s3
# AWS_S3_BUCKET=obleas-storage
# AWS_ACCESS_KEY_ID=tu_access_key
# AWS_SECRET_ACCESS_KEY=tu_secret_key
# AWS_REGION=us-east-1

# ==============================================
# RATE LIMITING - Seguridad
# ==============================================
# Límites por minuto según rol de usuario
# Valores actuales optimizados para 15 plantas
RATE_LIMIT_PLANTA=100
RATE_LIMIT_CAMARA=200
RATE_LIMIT_MUNICIPIO=1000
RATE_LIMIT_PUBLIC=30

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=info
# Valores posibles: error, warn, info, debug, verbose

# ==============================================
# MONITOREO (Producción)
# ==============================================
# URL base de la aplicación (para health checks)
APP_URL=http://localhost:3000
# En producción: APP_URL=https://api.tudominio.com

# ==============================================
# BACKUP (Producción)
# ==============================================
BACKUP_DIR=/home/backups/obleas
BACKUP_RETENTION_DAYS=30

# S3/Spaces para backups en la nube (opcional pero recomendado)
# BACKUP_S3_BUCKET=obleas-backups
# BACKUP_S3_REGION=us-east-1

# ==============================================
# NOTAS IMPORTANTES
# ==============================================
# 
# 🔒 SEGURIDAD:
# - NUNCA subir el archivo .env al repositorio
# - El .env debe estar en .gitignore
# - Usar variables de entorno del sistema en producción (systemd, docker, etc)
# 
# ✅ PRODUCCIÓN:
# - Cambiar JWT_SECRET por un valor aleatorio largo
# - Cambiar QR_SECRET por un valor aleatorio largo
# - Cambiar todas las contraseñas por valores seguros
# - Configurar CORS_ORIGIN con tu dominio real
# - Habilitar SSL/HTTPS
# - Configurar email para notificaciones
# 
# 📝 DESARROLLO:
# - Los valores por defecto funcionan para desarrollo local
# - PostgreSQL debe estar corriendo en localhost:5432
# - Frontend debe correr en localhost:5173
# 
# ==============================================

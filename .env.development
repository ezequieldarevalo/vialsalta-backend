# ==============================================
# DEVELOPMENT ENVIRONMENT
# ==============================================

NODE_ENV=development

# ==============================================
# BASE DE DATOS (PostgreSQL)
# ==============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=obleas_db

# ==============================================
# JWT & AUTENTICACIÓN
# ==============================================
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ==============================================
# SEGURIDAD QR
# ==============================================
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=dev-qr-secret-change-in-production

# ==============================================
# SERVIDOR
# ==============================================
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ==============================================
# ALMACENAMIENTO
# ==============================================
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# ==============================================
# EMAIL (OPCIONAL EN DESARROLLO)
# ==============================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=tu-email@gmail.com
# EMAIL_PASSWORD=tu_app_password

# ==============================================
# MERCADOPAGO (USAR SANDBOX EN DESARROLLO)
# ==============================================
# Obtener en: https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890-sandbox-token
MERCADOPAGO_PUBLIC_KEY=TEST-sandbox-public-key

# ==============================================
# FRONTEND URL
# ==============================================
FRONTEND_URL=http://localhost:5173

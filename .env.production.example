# ==============================================
# PRODUCTION ENVIRONMENT
# ==============================================

NODE_ENV=production

# ==============================================
# BASE DE DATOS (PostgreSQL)
# ==============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=obleas_user
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION
POSTGRES_DB=obleas_production

# ==============================================
# JWT & AUTENTICACIÓN
# ⚠️  IMPORTANTE: Generar secretos fuertes y únicos
# ==============================================
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_ESTE_SECRET_EN_PRODUCCION
JWT_EXPIRES_IN=7d

# ==============================================
# SEGURIDAD QR
# ⚠️  CRÍTICO: Cambiar en producción
# ==============================================
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=CAMBIAR_ESTE_QR_SECRET_EN_PRODUCCION

# ==============================================
# SERVIDOR
# ==============================================
PORT=3000
CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com

# ==============================================
# REDIS CACHE
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# TTL por defecto: 300 segundos (5 minutos)
CACHE_TTL=300

# ==============================================
# SENTRY (MONITOREO DE ERRORES)
# ==============================================
# Obtener DSN en: https://sentry.io/
# Dejar vacío para deshabilitar en desarrollo
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ==============================================
# ALMACENAMIENTO (DigitalOcean Spaces o S3)
# ==============================================
STORAGE_TYPE=spaces
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=obleas-production
SPACES_ACCESS_KEY=TU_ACCESS_KEY
SPACES_SECRET_KEY=TU_SECRET_KEY
SPACES_REGION=nyc3

# ==============================================
# EMAIL (PRODUCCIÓN)
# ==============================================
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=apikey
EMAIL_PASSWORD=TU_SENDGRID_API_KEY

# ==============================================
# MERCADOPAGO (PRODUCCIÓN)
# ==============================================
# Obtener credenciales de producción en:
# https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP-PRODUCTION-TOKEN
MERCADOPAGO_PUBLIC_KEY=APP-PRODUCTION-PUBLIC-KEY

# ==============================================
# FRONTEND URL
# ==============================================
FRONTEND_URL=https://tudominio.com

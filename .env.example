# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=obleas_db

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# QR Security - CRÍTICO: Cambiar en producción
# Genera un secreto único con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=your-super-secret-qr-signing-key-change-in-production-use-64-chars-minimum

# Frontend URL (para códigos QR)
FRONTEND_URL=http://localhost:5173

# Server
PORT=3000

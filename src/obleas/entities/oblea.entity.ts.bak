import {
  Entity,
  Column,
  PrimaryGeneratedColumn,
  CreateDateColumn,
  UpdateDateColumn,
  ManyToOne,
  JoinColumn,
  Index,
} from 'typeorm';
import { EstadoOblea } from '../../common/enums';
import { BloqueObleas } from '../../bloques/entities/bloque-obleas.entity';
import { Planta } from '../../plantas/entities/planta.entity';

/**
 * Entidad Oblea
 * Representa una oblea oficial del sistema
 */
@Entity('obleas')
@Index(['numero'], { unique: true })
@Index(['codigoQr'], { unique: true })
export class Oblea {
  @PrimaryGeneratedColumn()
  id: number;

  @Column()
  bloqueId: number;

  @Column()
  camaraId: number;

  @Column({ nullable: true })
  plantaId: number;

  @Column({ nullable: true })
  revisionId: number;

  @Column({ type: 'int', unique: true })
  numero: number;

  @Column({ type: 'text', unique: true, nullable: true })
  codigoQr: string;

  @Column({ type: 'boolean', default: false })
  qrActivo: boolean;

  @Column({
    type: 'enum',
    enum: EstadoOblea,
    default: EstadoOblea.DISPONIBLE,
  })
  estado: EstadoOblea;

  @CreateDateColumn()
  createdAt: Date;

  @Column({ type: 'timestamp', nullable: true })
  fechaAsignacion: Date;

  @Column({ type: 'timestamp', nullable: true })
  fechaEmision: Date;

  @UpdateDateColumn()
  updatedAt: Date;

  // Relaciones
  @ManyToOne(() => BloqueObleas)
  @JoinColumn({ name: 'bloqueId' })
  bloque: BloqueObleas;

  @ManyToOne(() => Planta, { nullable: true })
  @JoinColumn({ name: 'plantaId' })
  planta: Planta;
}
